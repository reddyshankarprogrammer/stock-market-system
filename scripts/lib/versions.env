# Pinned platform component versions, sourced by every scripts/*.sh installer.
# Bump a version through a pull request (never on the server), then re-run the installer:
# `helm upgrade --install` makes every installer idempotent.
# An empty value means "latest available at install time"; pin it after the first install.
# Last reviewed: 2026-10-17.

# K3s: channel used when K3S_VERSION is empty (stable | latest | v1.34 ...).
K3S_CHANNEL="${K3S_CHANNEL:-stable}"
K3S_VERSION="${K3S_VERSION:-}"

# Helm 3 client (empty = latest 3.x from the official installer).
HELM_VERSION="${HELM_VERSION:-}"

# Ingress: F5 NGINX Ingress Controller (OSS). The community ingress-nginx project reached
# end of maintenance in March 2026 and receives no security fixes.
NGINX_INGRESS_CHART="${NGINX_INGRESS_CHART:-oci://ghcr.io/nginx/charts/nginx-ingress}"
NGINX_INGRESS_CHART_VERSION="${NGINX_INGRESS_CHART_VERSION:-2.6.4}"

# cert-manager (Let's Encrypt ACME + local CA).
CERT_MANAGER_CHART_VERSION="${CERT_MANAGER_CHART_VERSION:-v1.21.1}"

# Strimzi Kafka operator (Kafka runs in KRaft mode; CRD API kafka.strimzi.io/v1).
STRIMZI_CHART_VERSION="${STRIMZI_CHART_VERSION:-1.1.0}"

# Argo CD (argo-helm chart 9.x = Argo CD 3.x).
ARGOCD_CHART_VERSION="${ARGOCD_CHART_VERSION:-9.5.20}"

# Prometheus, Grafana, Alertmanager.
KUBE_PROMETHEUS_STACK_CHART_VERSION="${KUBE_PROMETHEUS_STACK_CHART_VERSION:-87.19.2}"

# Loki (community-maintained chart since March 2026) and Grafana Alloy (Promtail successor;
# Promtail reached end of life on 2026-03-02).
LOKI_CHART_VERSION="${LOKI_CHART_VERSION:-18.4.4}"
ALLOY_CHART_VERSION="${ALLOY_CHART_VERSION:-}"

# Optional: Sealed Secrets controller for committing encrypted secrets to Git.
SEALED_SECRETS_CHART_VERSION="${SEALED_SECRETS_CHART_VERSION:-}"
