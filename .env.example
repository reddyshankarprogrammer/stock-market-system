#####################################################################
# Copy to .env (never committed) and fill in. Used by:
#   - every service locally (spring.config.import: optional:file:../.env)
#   - docker compose
#   - scripts/create-secrets.sh, which turns the values into Kubernetes Secrets
#####################################################################

APPLICATION_NAME=stock-market-system

# ---------------------------------------------------------------- MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=stock_market_system_db
MYSQL_USERNAME=root
MYSQL_ROOT_PASSWORD=change-me-root-password
# Kubernetes only: dedicated application account (the services never use root in the cluster).
MYSQL_APP_USERNAME=stockmarket
MYSQL_APP_PASSWORD=change-me-app-password
# Kubernetes only: read-only account of the Prometheus mysqld-exporter.
MYSQL_EXPORTER_PASSWORD=change-me-exporter-password

# ---------------------------------------------------------------- Redis / Valkey
REDIS_HOST=redis
REDIS_PORT=6379
# Kubernetes only (docker compose Redis has no password).
REDIS_PASSWORD=change-me-redis-password

# ---------------------------------------------------------------- Kafka
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_HEAP_OPTS=-Xms512M -Xmx512M
KAFKA_UI_PORT=8090

# ---------------------------------------------------------------- Service ports
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
MARKET_DATA_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
PORTFOLIO_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
ACCOUNT_SERVICE_PORT=8086

# ---------------------------------------------------------------- JWT
# At least 32 characters, identical for user-service and api-gateway. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRATION=86400000

# ---------------------------------------------------------------- External market data APIs
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# ---------------------------------------------------------------- Logging / actuator / JVM
LOG_LEVEL=INFO
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
JAVA_OPTS=-Xms512m -Xmx1024m
TZ=Asia/Dubai

# ---------------------------------------------------------------- Kubernetes platform (create-secrets.sh)
# Grafana login (password generated and kept in the cluster when empty).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Slack incoming webhook for Alertmanager (#stock-market-alerts).
ALERT_SLACK_WEBHOOK_URL=
# Pull secret for private GHCR images: GitHub user + classic PAT with read:packages only.
GHCR_USERNAME=
GHCR_TOKEN=
